# *****************************************************************
# Checkpoint postprocessing
# *****************************************************************

postprocess.initial_checkpoint = ./chk00000
postprocess.final_checkpoint   = ./chk00384
postprocess.volumetric_moment_order = 2
postprocess.surface_moment_order    = 1

case.name = rotation3d
reconstruction.name = lvira
advection.name = remap # not used but required by AmrCoreAdv

# geometry.prob_lo     =  0.0  0.0  0.0
# geometry.prob_hi     =  1.0  1.0  1.0
geometry.prob_lo     =  -0.5  -0.5  -0.5 
geometry.prob_hi     =  0.5  0.5  0.5
geometry.is_periodic =  1    1    1

# AMR hierarchy metadata
amr.v              = 1
amr.n_cell         = 8 8 8 
amr.max_level      = 1
amr.ref_ratio      = 2

amr.blocking_factor_x = 8
amr.blocking_factor_y = 8
amr.blocking_factor_z = 8
amr.max_grid_size     = 32
amr.regrid_int        = 1

# Parameters still read by AmrCoreAdv.
adv.cfl       = 0.25
adv.do_reflux = 1
amr.plot_file = plt
amr.plot_int  = -1
amr.chk_file  = chk
amr.chk_int   = -1
